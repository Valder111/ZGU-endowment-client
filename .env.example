# Use / for a user GitHub Pages site; /repository/ for a project site.
BASE_PATH=/

# Port used by the local Vite development server.
DEV_PORT=5173

# Public API address ending in /api/v1, or /api/v1 for a same-origin proxy.
VITE_API_BASE_URL=

# Optional Vite development proxy. Set to the API origin, without /api/v1.
STAFF_API_PROXY_TARGET=

# Production nginx upstream, host:port on the compose network. No scheme.
API_UPSTREAM=server:8080

