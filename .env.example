# Use / for a user GitHub Pages site; /repository/ for a project site.
BASE_PATH=/

# Port used by the local Vite development server.
DEV_PORT=5173

# Public API address ending in /api/v1, or /api/v1 for a same-origin proxy.
VITE_API_BASE_URL=

# Checkout is available when the configured API supports /payments/checkout.
# Set false to disable checkout without hiding the form.
VITE_PAYMENTS_ENABLED=true
# Allow redirects to the Best2Pay test environment.
VITE_PAYMENTS_SANDBOX=false
# Optional JSON: map fund/direction:science/etc. to real published project UUIDs.
# A fund mapping also serves all directions without their own override.
# Without a mapping the donor explicitly chooses an open project from the API.
VITE_DONATION_PROJECT_MAP={}

# Optional Vite development proxy. Set to the API origin, without /api/v1.
STAFF_API_PROXY_TARGET=

# Production nginx upstream, host:port on the compose network. No scheme.
API_UPSTREAM=server:8080

